{
  "name": "yang-portfolio-events",
  "main": "src/collector.mjs",
  "compatibility_date": "2026-10-03",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": true,
  "preview_urls": false,
  "observability": {
    "enabled": false
  },
  "vars": {
    "COLLECTION_ENABLED": "false"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "yang-portfolio-analytics",
      "database_id": "REPLACE_WITH_D1_ID",
      "migrations_dir": "migrations"
    }
  ],
  "ratelimits": [
    {
      "name": "RATE_LIMITER",
      "namespace_id": "410026",
      "simple": {
        "limit": 60,
        "period": 60
      }
    },
    {
      "name": "EDGE_RATE_LIMITER",
      "namespace_id": "410027",
      "simple": {
        "limit": 300,
        "period": 60
      }
    }
  ],
  "triggers": {
    "crons": [
      "15 * * * *"
    ]
  }
}
